{
  "name": "ipas-ai-daily",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postinstall": "prisma generate",
    "db:push": "prisma db push --accept-data-loss",
    "db:docker:up": "docker run --name ipas-ai-daily-db -e POSTGRES_USER=ipas -e POSTGRES_PASSWORD=ipas_dev_password -e POSTGRES_DB=ipas_ai_daily -p 5433:5432 -v ipas_ai_daily_pgdata:/var/lib/postgresql/data -d postgres:16-alpine",
    "db:docker:start": "docker start ipas-ai-daily-db",
    "db:docker:stop": "docker stop ipas-ai-daily-db",
    "seed:365": "node scripts/seed-local-365-all.mjs",
    "seed:local-365": "node scripts/seed-local-365-all.mjs",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/adapter-ppg": "^7.8.0",
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.3",
    "next": "16.2.6",
    "nodemailer": "^8.0.7",
    "pg": "^8.20.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "prisma": "^6.19.0",
    "typescript": "^5"
  }
}
